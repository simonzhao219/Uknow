# Dependencies
node_modules/

# Build output
build/
dist/

# 資料傾印/匯出——含個資，一律不進版本庫（見 src/utils/repoHygiene.test.ts）
export/
src/imports/

# Environment variables
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# TypeScript
*.tsbuildinfo
supabase/.temp/
supabase/.branches/

# Claude Code 本機狀態（tdd-lock 是 TDD 相位鎖的 session 狀態，絕不入版控）
.claude/tdd-lock
.claude/settings.local.json
CLAUDE.local.md
# harness 感測器:session 內的緩衝與鎖檔都是本機狀態（與 tdd-lock 同性質）。
# 只有落檔後的 sessions.jsonl **要**進版控——那是唯一能跨 session 的通道。
.claude/metrics/*
!.claude/metrics/sessions.jsonl

# E2E (pytest-bdd + Playwright)
e2e/journey/.run/
e2e/.venv/
e2e/__pycache__/
e2e/**/__pycache__/
e2e/.pytest_cache/
e2e/test-results/
e2e/playwright-report/
e2e/playwright/.cache/

# Python bytecode（.claude/hooks 的 py_compile 副產物）
__pycache__/

# vitest 覆蓋率報告(每次執行重新產生)
coverage/
