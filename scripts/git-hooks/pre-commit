#!/usr/bin/env bash
# commit 閘門：npm run check 全綠才放行。
#
# 由 package.json 的 prepare script 透過 core.hooksPath 自動掛載——
# npm ci / npm i 之後即生效，全新 clone 不需要任何手動步驟。
#
# 紅燈通道：TDD 流程要求先 commit 失敗中的測試（test(red)），此時 vitest
# 必紅——若無此通道，本 hook 會擋掉框架自己規定的 commit（設計審查時的
# P0 死鎖）。.claude/tdd-lock 存在即代表紅燈期：跳過 vitest，只跑靜態
# 閘門（biome / typecheck / knip）。紅燈的定義是「編譯過、斷言失敗」，
# 所以靜態閘門仍須全綠（受測 API 先建 stub）。解鎖唯一路徑是
# scripts/tdd-unlock.sh（check 全綠才刪鎖）。
#
# 測試接縫：PRE_COMMIT_DRY_RUN=1 只印出「會做什麼決策」而不執行閘門，
# 並且**一律以 99 退出**——所以它永遠不可能被當成繞過閘門的手段
# （dry-run 跑出來的 commit 一定失敗）。scripts/test-hooks.py 靠它驗行為。
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

DRY_RUN="${PRE_COMMIT_DRY_RUN:-0}"
staged=$(git diff --cached --name-only --diff-filter=ACMR)

# 測試接縫：dry-run 時可指定假的 staged 清單。
# 沒有這個接縫的話,hook 的行為測試就得讀真實 git index——結果是
# 「有沒有暫存後端檔案」決定測試通過與否:CI 的乾淨 checkout 恆綠,
# 開發者正在改後端時恆紅。那種測試在該說話時剛好不說話。
# 與 PRE_COMMIT_FAKE_MERGE 同樣只在 dry-run 生效,而 dry-run 必定以
# 99 退出,所以不可能成為繞過閘門的手段。
if [ "$DRY_RUN" = "1" ] && [ -n "${PRE_COMMIT_FAKE_STAGED:-}" ]; then
  staged="$PRE_COMMIT_FAKE_STAGED"
fi

# 綠燈安靜化的包裝器（抽成獨立檔案才有可測的接縫，理由見該檔開頭）。
# shellcheck source=scripts/git-hooks/lib-quiet.sh
. "$(git rev-parse --show-toplevel)/scripts/git-hooks/lib-quiet.sh"

# 執行一組閘門；dry-run 時只宣告不執行。
# 輸出處理：綠燈折疊成一行、紅燈原樣全印（run_gate_quiet）。exit code 一律
# 原樣傳遞——這是 commit 閘門，吞掉退出碼等於閘門「看起來正常」地失效。
run_gate() {
  local label="$1"
  shift
  if [ "$DRY_RUN" = "1" ]; then
    echo "DRYRUN: WOULD_RUN $label"
    return 0
  fi
  run_gate_quiet "$label" "$@"
}

if [ -f .claude/tdd-lock ]; then
  echo "[pre-commit] TDD 紅燈期（.claude/tdd-lock 存在）：跳過 vitest，只跑靜態閘門"
  [ "$DRY_RUN" = "1" ] && echo "DRYRUN: MODE red-channel"
  if ! run_gate static-gates bash -c 'npx biome check . && npx tsc --noEmit -p . && npx knip --include files,dependencies'; then
    echo "" >&2
    echo "[pre-commit] 靜態閘門未過，commit 已擋下。" >&2
    echo "  紅燈 = 編譯過、斷言失敗。請先讓 biome/typecheck/knip 全綠" >&2
    echo "  （受測 API 尚不存在時，先建最小 stub 讓型別過）。" >&2
    exit 1
  fi
else
  [ "$DRY_RUN" = "1" ] && echo "DRYRUN: MODE full-check"
  if ! run_gate npm-run-check npm run check; then
    echo "" >&2
    echo "[pre-commit] npm run check 未過，commit 已擋下。修復後重試。" >&2
    echo "  若這是 TDD 的紅燈測試 commit：先 touch .claude/tdd-lock 進入紅燈期" >&2
    echo "  （綠燈後用 scripts/tdd-unlock.sh 解鎖），見 CLAUDE.md TDD 流程。" >&2
    exit 1
  fi
fi

# Deno 側閘門：只有 supabase/functions/ 有改動才跑（fmt --check 免網路、
# 型別檢查要能連 registry 解析相依，兩者皆秒級、免 supabase start；
# deno task test 需要本地 supabase，刻意留給 CI 的 api-tests 軌）。
#
# 合併例外：merge commit 帶進的後端變更是上游 commit（已過 CI api-tests），
# 不是本次在寫的東西。缺 deno 時擋 merge 只會讓沒裝 deno 的環境無法完成
# 任何含後端檔案的合併（死鎖），所以合併中缺 deno 降為警告；deno 在的話
# 照跑不誤——免費的驗證沒有不要的道理。
if echo "$staged" | grep -q '^supabase/functions/'; then
  merging=false
  if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
    merging=true
  fi
  # dry-run 專用的假合併訊號（只在 dry-run 生效，而 dry-run 必定失敗退出，
  # 所以它不可能成為真正的繞道）
  if [ "$DRY_RUN" = "1" ] && [ "${PRE_COMMIT_FAKE_MERGE:-0}" = "1" ]; then
    merging=true
  fi

  # dry-run 專用的雙向假訊號（present / absent）：沒有它，這幾條分支的
  # 行為測試會取決於「跑測試的那台機器裝了 deno 沒」——本機裝了走 A 路、
  # CI 的 framework-check runner 沒裝走 B 路，同一份測試在兩邊給不同
  # 答案（2026-07-25 PR #114 就是這樣紅的）。必須兩個方向都能指定，
  # 只做單向（假裝沒有）仍會讓「有 deno」那條依賴環境。
  has_deno=false
  if command -v deno >/dev/null 2>&1; then has_deno=true; fi
  if [ "$DRY_RUN" = "1" ]; then
    case "${PRE_COMMIT_FAKE_DENO:-}" in
      present) has_deno=true ;;
      absent) has_deno=false ;;
    esac
  fi

  if [ "$has_deno" = true ]; then
    [ "$DRY_RUN" = "1" ] && echo "DRYRUN: DENO deno-present"
    if ! run_gate deno-fmt bash -c 'cd supabase/functions && deno fmt --check'; then
      echo "" >&2
      echo "[pre-commit] deno fmt --check 未過，commit 已擋下。" >&2
      echo "  修正格式：cd supabase/functions && deno fmt" >&2
      exit 1
    fi

    # 網路例外（與下面的 merge 例外同源）：型別檢查要解析 jsr:/npm: 相依，
    # 也就是要連得上 registry。沙箱 egress 政策擋掉 jsr.io、離線、registry
    # 掛掉時，這一步必然失敗且與程式碼無關——照擋等於「沒有網路就不准寫
    # 後端」，又是一個死鎖。故分辨「型別真的有錯」與「根本跑不起來」：
    # 後者降為警告，交給 CI 的 api-tests 軌（那裡有網路，跑的是同一條指令）。
    # 判別只認 deno 自己的相依解析／連線失敗訊息；型別錯誤不會長這樣，
    # 仍然照擋。
    if [ "$DRY_RUN" = "1" ]; then
      echo "DRYRUN: WOULD_RUN deno-check"
    else
      check_out=$(cd supabase/functions && deno task check 2>&1)
      check_rc=$?
      if [ $check_rc -ne 0 ]; then
        if echo "$check_out" | grep -qE "failed to load|error sending request|403 Forbidden|Import '.*' failed|connection error|dns error|error trying to connect"; then
          echo "[pre-commit] deno task check 無法解析相依（registry 不可達），降為警告：" >&2
          echo "$check_out" | grep -E "^error" | head -3 >&2
          echo "  型別檢查交由 CI 的 api-tests 軌把關（該環境有網路）。" >&2
        else
          echo "$check_out" >&2
          echo "" >&2
          echo "[pre-commit] deno task check 未過（型別錯誤），commit 已擋下。" >&2
          exit 1
        fi
      fi
    fi
  elif [ "$merging" = true ]; then
    echo "[pre-commit] 合併中且本機無 deno：後端變更來自上游（已過 CI），略過 Deno 閘門。"
    [ "$DRY_RUN" = "1" ] && echo "DRYRUN: DENO merge-exception-skip"
  elif [ "$DRY_RUN" = "1" ]; then
    # dry-run 只宣告決策,不執行也不提前退出——保持「一律 99」的契約,
    # 否則退出碼會隨環境變動,行為測試就失去可比性。
    echo "DRYRUN: DENO block-no-deno"
  else
    echo "" >&2
    echo "[pre-commit] supabase/functions/ 有變更但本機沒有 deno，commit 已擋下。" >&2
    echo "  安裝：https://docs.deno.com/runtime/getting_started/installation/" >&2
    echo "  （CI 的 api-tests 軌仍會把關，但缺 deno 表示你無法在本機驗證後端改動）" >&2
    exit 1
  fi
fi

# 文件旁白提醒(advisory,不擋 commit)：§14 落差消除時常見的復發模式
# 是在刪除處或別的文件另外補一段「已定案不提供 X、非落差」的解釋——
# 這種措辭在 §14 表格與 vestigial 殘跡註記裡是合法的，grep 分不出
# 語意，所以只能提醒不能擋（見 .claude/rules/document-writing.md、
# friction-log 2026-07-25 那則教訓）。
doc_diff=$(git diff --cached -- 'docs/**/*.md' 'e2e/**/*.md' 2>/dev/null)
if [ "$DRY_RUN" = "1" ] && [ -n "${PRE_COMMIT_FAKE_DOC_DIFF:-}" ]; then
  doc_diff="$PRE_COMMIT_FAKE_DOC_DIFF"
fi
if echo "$doc_diff" | grep -E '^\+' | grep -v '^\+\+\+ ' \
    | grep -qE '已定案不提供|已定案的產品決策|非落差|不必再列為待實作'; then
  echo "[pre-commit] 提醒:新增文字疑似「解釋功能為什麼不存在」——確認不是重複旁白" >&2
  echo "  （規則見 .claude/rules/document-writing.md）。" >&2
  [ "$DRY_RUN" = "1" ] && echo "DRYRUN: DOC_ADVISORY triggered"
fi

if [ "$DRY_RUN" = "1" ]; then
  echo "DRYRUN: WOULD_PASS"
  exit 99
fi

exit 0
